# ==============================================================================
# Bot-MM: Multi-Chain Paper Trading & Alpha Analytics Engine — Environment Config
# ==============================================================================
# Copy this file to '.env' and fill in your developer keys.
# NEVER commit your live '.env' to git or share your Telegram credentials!

# ------------------------------------------------------------------------------
# 1. RPC Endpoints (100% Free Developer Tier Quotas)
# ------------------------------------------------------------------------------
# Alchemy Base (EVM) RPC (Free Tier: 20 CU/s cap)
BASE_RPC_HTTP=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Helius Solana (SVM) RPC (Free Tier: 8 req/s cap)
SOLANA_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# ------------------------------------------------------------------------------
# 2. Private Builder & MEV Protection (Zero-Sandwich Routing)
# ------------------------------------------------------------------------------
FLASHBOTS_RPC=https://rpc.flashbots.net
TITAN_BUILDER_RPC=https://rpc.titanbuilder.xyz
MEV_BLOCKER_RPC=https://rpc.mevblocker.io
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor

# ------------------------------------------------------------------------------
# 3. DEX Protocol Addresses
# ------------------------------------------------------------------------------
AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c749566343833341fdC
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# ------------------------------------------------------------------------------
# 4. Telegram & X (Twitter) Sentiment Scraper (Optional)
# ------------------------------------------------------------------------------
# Twitter/X API v2 Bearer Token
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# Obtain API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME="alpha_engine_listener"
TELEGRAM_SESSION_STRING=

# Optional Telegram Bot Token (from @BotFather) for headless bot-mode login
TELEGRAM_BOT_TOKEN=

# Comma-separated list of target alpha call channels or usernames
TELEGRAM_CHANNELS="insiderpaper,disclosetv,TreeNewsFeed,lookonchain,WatcherGuru"

# Authorized Telegram user IDs (comma-separated integers) for interactive DM commands (/status, /scan, /trades, /news, /whales)
TELEGRAM_ADMIN_IDS=

# ------------------------------------------------------------------------------
# 5. AlphaSupervisor-AI Autonomous Risk Engine
# ------------------------------------------------------------------------------
AI_SUPERVISOR_ENABLED=true
# AI Provider: gemini | openai | openrouter | anthropic | groq | deepseek | ollama
AI_PROVIDER=gemini
# Optional secondary fallback provider if primary times out or hits rate limits
AI_FALLBACK_PROVIDER=

# Provider Credentials (leave blank for local deterministic heuristics fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Custom OpenAI-compatible endpoint (e.g. http://localhost:11434/v1 for Ollama, vLLM, Together)
AI_BASE_URL=

# AI Model identifier (e.g. gemini-3.8-flash, gemini-3.1-pro-preview, claude-3-7-sonnet-latest, claude-3-5-sonnet-latest, gpt-4o, gpt-4.5-preview, o3-mini, llama-3.3-70b-versatile, deepseek-chat)
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_S=4.0
AI_STRICT_VETO=true


# ------------------------------------------------------------------------------
# 6. Engine Controls & Database Persistence
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_QUEUE_SIZE=100
DB_PATH=paper_trading.db
SNAPSHOT_INTERVAL_S=60

# ------------------------------------------------------------------------------
# 6. Risk Controls & Capital Simulation (Zero-Capital Simulation)
# ------------------------------------------------------------------------------
# Maximum fraction of portfolio equity risked per trade (Half-Kelly, 0.01 = 1%)
MAX_PORTFOLIO_RISK_PCT=0.01
# Maximum autonomous portfolio risk allocation per trade (0.05 = 5%)
MAX_AUTONOMOUS_RISK_PCT=0.05

# Half-Kelly Sizing & Calibration Controls
KELLY_MIN_CLOSED_TRADES=30
KELLY_UNCALIBRATED_FRACTION=0.01
KELLY_MULTIPLIER=0.5
KELLY_SHRINKAGE_TRADES=20

# Initial hard stop-loss trigger (-0.15 = -15% drawdown)
STOP_LOSS_PCT=-0.15

# Simulated Initial Native Balances
INITIAL_SOL_BALANCE=10.0
INITIAL_ETH_BALANCE=2.0

# Valuation Baselines in USD (Bootstrap/Static Override Only)
# When ALLOW_STATIC_NATIVE_PRICES=false (default), live NativePriceService is used.
# When ALLOW_STATIC_NATIVE_PRICES=true, static overrides below are used (logs WARNING at startup).
ALLOW_STATIC_NATIVE_PRICES=false
SOL_PRICE_USD=150.0
ETH_PRICE_USD=3400.0

# Native Price Service Configuration (Live multi-source pricing & fail-closed gating)
NATIVE_PRICE_REFRESH_INTERVAL_S=30.0
NATIVE_PRICE_CACHE_TTL_S=15.0
NATIVE_PRICE_MAX_AGE_S=60.0
NATIVE_PRICE_DIVERGENCE_TOLERANCE_PCT=5.0

# ------------------------------------------------------------------------------
# 7. HFT Noise Immunity & Sybil / Dev-Bundle Protection
# ------------------------------------------------------------------------------
# Grace period in seconds to suppress micro-tick noise stop-outs (default: 15s)
EXIT_GRACE_PERIOD_SEC=15.0

# Trusted upstream DNS/DoH servers to bypass local sinkholes without log warnings
DNS_DOH_SERVERS="1.1.1.1,8.8.8.8"

# Smart Launch Buffer parameters (calibrated for paper trading)
OBSERVATION_WINDOW_MIN_SEC=30
OBSERVATION_WINDOW_MAX_SEC=90
BUFFER_TARGET_VOLUME_SOL=0.8
BUFFER_MIN_BUYS=3
BUFFER_MIN_UNIQUE_BUYERS=2

# Maximum fraction of buys clustered in identical slot before flagging DEV_BUNDLED
SLOT_BUNDLE_THRESHOLD=0.60

# ------------------------------------------------------------------------------
# 8. Ruflo Multi-Agent Swarm Orchestration & Multi-Chain RPC Health
# ------------------------------------------------------------------------------
RUFLO_ENABLED=true
RUFLO_TOPOLOGY="hierarchical"
RUFLO_CONSENSUS="bft"
RUFLO_REFLECTION_INTERVAL_S=60.0
RUFLO_MAX_MEMORY_EPISODES=2000
PAPER_TRADING_MODE=true

# Multi-chain RPC latency and block desync health thresholds
RPC_LATENCY_THRESHOLD_MS=400.0
RPC_MAX_BLOCK_LAG=2

# ------------------------------------------------------------------------------
# 9. Trade Cost Model & Execution Fee Schedule
# ------------------------------------------------------------------------------
# Venue trading fees in basis points (bps, 1 bps = 0.01%)
# Verified from official protocol documentation on 2026-11-11
FEE_PUMP_FUN_BPS=100
FEE_PUMPSWAP_BPS=30
FEE_RAYDIUM_AMM_BPS=25
FEE_RAYDIUM_CPMM_BPS=25
FEE_RAYDIUM_CLMM_BPS=25
FEE_UNISWAP_V2_BPS=30
FEE_UNISWAP_V3_BPS=30
FEE_AERODROME_BPS=30

# Extra slippage allowance in bps (default: 0, empirically calibrated, not arbitrary)
EXTRA_SLIPPAGE_BPS=0

# Solana network fee parameters (lamports, 1 SOL = 1e9 lamports)
SOLANA_BASE_FEE_LAMPORTS=5000
SOLANA_PRIORITY_FEE_LAMPORTS=100000
SOLANA_JITO_TIP_LAMPORTS=10000
SOLANA_CONSERVATIVE_FEE_SOL=0.0005

# Base (EVM) network fee parameters
BASE_SWAP_GAS_UNITS=180000
BASE_GAS_PRICE_GWEI=0.05
BASE_L1_DATA_FEE_ETH=0.00001
BASE_CONSERVATIVE_FEE_ETH=0.00005

# ------------------------------------------------------------------------------
# 10. Pool State Provenance & Derived Reserves Execution Policy
# ------------------------------------------------------------------------------
# Policy for trading pools whose reserves are derived from API USD heuristics rather than exact on-chain:
# "reject" (default, safer): fail closed and reject signal with 'derived_reserves_rejected'
# "cap_size": cap order size to a maximum fraction of derived pool depth
DERIVED_RESERVES_POLICY=reject
DERIVED_RESERVES_DEPTH_CAP_PCT=0.02

# =============================================================================
# 11. Latency & Conditional MEV Simulation Parameters
# =============================================================================
# Deterministic seed for reproducible latency and MEV draws
EXECUTION_SEED=42

# Solana latency bounds in milliseconds (Source: https://docs.solanalabs.com/consensus/fork-generation#slot-time, Verified: 2026-11-11)
LATENCY_MIN_MS_SOLANA=45
LATENCY_MAX_MS_SOLANA=320

# Base latency bounds in milliseconds (Source: https://docs.base.org/chain/block-time/, Verified: 2026-11-11)
LATENCY_MIN_MS_BASE=150
LATENCY_MAX_MS_BASE=2000

# Distribution: lognormal (default) or uniform
LATENCY_DISTRIBUTION=lognormal

# Freshness bound at fill time: reject if state is older than this (fail-closed)
FILL_MAX_STALE_MS=4000

# Paper trading pending fill wait timeout in milliseconds
FILL_TIMEOUT_MS=10000

# Route protection default: false for public mempool, true for private relay
DEFAULT_IS_PRIVATE_ROUTE=false

# MEV frontrun exploitability thresholds in public mempool
MEV_SANDWICH_DEPTH_THRESHOLD=0.005
MEV_SANDWICH_SLIPPAGE_THRESHOLD_BPS=50
MEV_MAX_SANDWICH_IMPACT_BPS=500
